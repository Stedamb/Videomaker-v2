---
import PageLayout from '../layouts/PageLayout.astro';
import Header from '../components/Header';
import Homepage from '../components/Homepage';

const projects = [
  {
    title: 'Supernova',
    description: 'Description for video 1',
    source: '/supernova.mp4',
    link: '/projects/supernova',
    preview: 'Preview for video 1',
  },
  {
    title: 'Video 2',
    description: 'Description for video 2',
    source: '/supernova.mp4',
    link: '/video2',
    preview: 'Preview for video 2',
  },
  {
    title: 'Video 3',
    description: 'Description for video 3',
    source: '/supernova.mp4',
    link: '/video3',
    preview: 'Preview for video 3',
  },
];
---
<PageLayout title="Home" showLoader>
  <Header slot="header" client:visible />
  <main>
    <Homepage projects={projects} client:visible />
  </main>
</PageLayout>
